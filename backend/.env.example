# ==============================================================================
# CampusSync Backend Environment Configuration Template
# Copy this file to .env and fill in your environment-specific credentials.
# NEVER commit .env with production passwords or secret keys to GitHub.
# ==============================================================================

# PostgreSQL Connection String (Format: postgresql://username:password@host:port/database_name)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_sync

# JWT Authentication Secret & Algorithm
# Generate a secure 256-bit key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
ENVIRONMENT=development
APP_NAME=CampusSync API
DEBUG=true

# CORS Allowed Origins (Comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
